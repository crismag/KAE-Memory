# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. See docs/09_development/AWS_DEMONSTRATION_BASELINE.md for the
# secrets-management rules.

# Database connection used by the application and by Alembic migrations.
#
# CockroachDB Cloud:
#   postgresql+psycopg://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Local CockroachDB (insecure, development only):
#   postgresql+psycopg://root@localhost:26257/kae?sslmode=disable
# SQLite, for running migrations without a cluster:
#   sqlite+pysqlite:///./local.db
KAE_DATABASE_URL=
