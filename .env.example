# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Use placeholders here, never live credentials.
#
# Local overrides may also live in .local/ or .secrets/, both ignored. On a
# hosted instance, prefer a host-managed environment file outside the repository
# and an IAM instance role over stored AWS keys.

# --- Application ---------------------------------------------------------

KAE_ENV=
KAE_LOG_LEVEL=

# --- Database ------------------------------------------------------------
# Used by the application and by Alembic migrations. CockroachDB is the only
# supported engine, in production and in tests alike (ADR-0011).
#
# CockroachDB Cloud:
#   cockroachdb+psycopg://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Local CockroachDB (insecure, development only):
#   cockroachdb+psycopg://root@localhost:26257/kae?sslmode=disable
KAE_DATABASE_URL=

# Overrides the throwaway test database. Defaults to the local single-node
# cluster started by `make test-db-up`.
KAE_TEST_DATABASE_URL=

# --- API and worker ------------------------------------------------------
# Read by the entrypoints M10 adds. Neither exists yet (ADR-0013).

KAE_API_HOST=
KAE_API_PORT=

KAE_WORKER_ID=
KAE_LEASE_DURATION_SECONDS=

# --- AWS -----------------------------------------------------------------
# Optional (ADR-0013). Bedrock backs extraction and embeddings; the queue URL is
# reserved and not yet read by anything.

AWS_REGION=
KAE_SQS_QUEUE_URL=
