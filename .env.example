# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Use placeholders here, never live credentials.
#
# Local overrides may also live in .local/ or .secrets/, both ignored. On a
# hosted instance, prefer a host-managed environment file outside the repository
# and an IAM instance role over stored AWS keys.

# --- Application ---------------------------------------------------------

KAE_ENV=
KAE_LOG_LEVEL=

# --- Database ------------------------------------------------------------
# Used by the application and by Alembic migrations.
#
# CockroachDB and PostgreSQL with pgvector are both fully supported (ADR-0022).
# Neither is a fallback for the other, and there is no default: an unset
# provider is refused rather than guessed, because starting against an engine
# nobody selected surfaces later as missing data instead of a config error.
#
#   cockroachdb | postgresql
KAE_DATABASE_PROVIDER=

# The URL for the selected provider. Set the one that matches; the other is
# ignored, so a machine can hold both without either becoming ambiguous.
#
# PostgreSQL (needs the pgvector extension; migrations create it):
#   postgresql+psycopg://kae:kae@localhost:5432/kae_memory
KAE_POSTGRESQL_URL=

# CockroachDB Cloud:
#   cockroachdb+psycopg://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Local CockroachDB (insecure, development only):
#   cockroachdb+psycopg://root@localhost:26257/kae?sslmode=disable
KAE_COCKROACHDB_URL=

# One URL for whichever provider is selected. Honoured only once
# KAE_DATABASE_PROVIDER is set: a connection string never implies a provider.
KAE_DATABASE_URL=

# --- Tests ---------------------------------------------------------------
# Test configuration is separate from the application's and never falls back to
# it. A suite that could read KAE_DATABASE_URL is one mistaken environment away
# from truncating a real database — which has happened here once already.
#
# Which engine the suite runs against. Defaults to postgresql. A default engine
# is safe; a default connection would not be, so there is no default URL.
KAE_TEST_DATABASE_PROVIDER=

# Required for any live-database test. Without it those tests skip with a clear
# reason rather than failing, so `pytest` still runs on a machine with no
# database at all.
#
# The name must designate it as disposable — containing _test, test_, or
# testing — because destructive tests refuse anything else. Being on localhost
# is not enough: a developer keeps real work there too.
KAE_TEST_DATABASE_URL=

# Optional per-provider test URLs, so a machine can hold both.
KAE_TEST_POSTGRESQL_URL=
KAE_TEST_COCKROACHDB_URL=

# --- API and worker ------------------------------------------------------
# Read by the entrypoints M10 adds. Neither exists yet (ADR-0013).

# Binds to loopback unless set. The API has no authentication (ADR-0014), so a
# process listening on every interface is a data breach, not a convenience.
KAE_API_HOST=
KAE_API_PORT=

# Comma-separated origins allowed to call the API from a browser. Empty means
# none, so a split-origin deployment fails closed. Only needed when the frontend
# is hosted separately from the API (ADR-0017) — and read the warning in
# deploy/static-site/README.md before using it.
KAE_CORS_ORIGINS=

KAE_WORKER_ID=
KAE_LEASE_DURATION_SECONDS=
KAE_WORKER_POLL_SECONDS=

# Which extraction adapter the worker uses: 'deterministic' (default, offline,
# no credentials) or 'bedrock' (live, needs a region and model access).
KAE_EXTRACTION=
# Embedding provider: 'deterministic' (default, hash-derived, cannot rank
# meaning) or 'titan' (Amazon Titan Text Embeddings V2 on Bedrock).
# Region resolves from AWS_REGION, AWS_DEFAULT_REGION, then the AWS profile.
KAE_EMBEDDING=
# Observation classifier: 'deterministic' (default, rule-based, honest about
# it) or 'semantic' (Claude on Bedrock, reads meaning). This decides a
# retention tier, not what the project knows — extraction is a separate path
# over the same text. Semantic falls back to rules if a call fails, and says
# so per call; a missing region at startup is refused rather than degraded.
KAE_OBSERVATION_CLASSIFIER=

# --- AWS -----------------------------------------------------------------
# Optional (ADR-0013). Bedrock backs extraction and embeddings.
#
# References only, never keys. Store the access key with `aws configure --profile
# kae-memory`, which writes ~/.aws/credentials outside this repository, and name
# the profile here. A leaked file naming a profile is harmless; a leaked file
# containing a secret access key is an incident.
#
# On EC2 neither of these is set: an instance role issues short-lived credentials
# automatically, and a long-lived key on a public host is how AWS accounts are
# compromised (ADR-0017).

AWS_PROFILE=
AWS_REGION=
# boto3 honours either; the worker currently reads AWS_REGION only.
AWS_DEFAULT_REGION=

# Reserved. SQS is not authorised and nothing reads this (OQ-017).
KAE_SQS_QUEUE_URL=
