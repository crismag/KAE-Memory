# nginx in front of the KAE-Memory API.
#
# KAE-Memory serves no UI (ADR-0026) — this proxies the API and nothing else.
# A browser client is KAE-Studio's, hosted separately, and reaches this over
# authenticated HTTPS with CORS configured via KAE_CORS_ORIGINS.
#
# Copy to /etc/nginx/sites-available/kae.conf, adjust server_name, add a
# certificate, and enable.

server {
    listen 80;
    server_name kae.example.com;

    # Terminate TLS here in a real deployment. Bearer tokens over plaintext are
    # bearer tokens on the wire.
    # return 301 https://$host$request_uri;

    client_max_body_size 2m;

    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: no buffering, and a long read timeout. Without
        # these the run stream is delivered in bursts or cut at 60 seconds.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        access_log off;
    }
}
