# nginx, same-origin: this server serves the built frontend *and* proxies the
# API, so the browser sees one origin and no CORS is needed.
#
# That is the recommended shape (ADR-0017). The alternative — frontend on
# external static hosting, API reachable directly — exposes an API with no
# authentication to the public internet and requires a security-group allowlist.
#
# Copy to /etc/nginx/sites-available/kae.conf, adjust server_name, add a
# certificate, and enable.

server {
    listen 80;
    server_name kae.example.com;

    # Terminate TLS here in a real deployment. Serving an unauthenticated API
    # over plaintext puts the database password's blast radius on the wire.
    # return 301 https://$host$request_uri;

    root /var/www/kae-memory;
    index index.html;

    client_max_body_size 2m;

    # The workspace is a client-side router (ADR-0009): unknown paths are
    # application routes, not missing files.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: no buffering, and a long read timeout. Without
        # these the run stream is delivered in bursts or cut at 60 seconds.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        access_log off;
    }
}
